int ResolveGmtOffset()
  {
   if(!(AutoGMT && !IsTesting()))
      return GMTOffset;

   char postData[], result[];
   string resultHeaders = "";
   RefreshRates();
   datetime serverNow = TimeCurrent();
   if(WebRequest("GET", GMT_URL, "", 10, postData, result, resultHeaders) != -1)
     {
      string body = CharArrayToString(result, 0, -1, 0);
      int offset = (int)MathRound((double)((long)serverNow - (long)StrToTime(body)) / 3600.0);
      ArrayFree(result);
      ArrayFree(postData);
      return offset;
     }
   int err = GetLastError();
   ResetLastError();
   Print("Error: ", err);
   MessageBox("Add the address '" + GMT_URL + "' in the list of allowed URLs on tab 'Expert Advisors'", "Error", 64);
   ExpertRemove();
   return 0;
  }

int OnInit()
  {
   g_gmtOffset = ResolveGmtOffset();

   g_stopLevelPx = MarketInfo(_Symbol, MODE_STOPLEVEL) * Point;
   g_pip = (Digits == 5 || Digits == 3) ? Point * 10.0 : Point;
   g_trailPx = TrailingStop * g_pip;
   g_slPx = StopLoss * g_pip;
   g_tpPx = TakeProfit * g_pip;
   g_beDistPx = BreakEven * g_pip;
   g_beLockPx = BEpoint * g_pip;
   g_blocked = true;

   //--- serial key check (logic unchanged)
   string key = Serial_Number;
   string acct = IntegerToString(AccountNumber());
   for(datetime stamp = 1400198400; stamp <= 4102358400; stamp += 86400)
     {
      string d = IntegerToString(stamp);
      string h1 = MD5("NR nestorov both asparuh fxiknow_ea5.0 " + d);
      string h2 = MD5(acct + " nestorov both asparuh fxiknow_ea5.0 " + d);
      string h3 = MD5("NR nestorov real asparuh fxiknow_ea5.0 " + d);
      string h4 = MD5(acct + " nestorov real asparuh fxiknow_ea5.0 " + d);
      StringToUpper(h1);
      StringToUpper(h2);
      StringToUpper(h3);
      StringToUpper(h4);
      // INFERRED: decompiler garbled one of the four comparisons; all four hashes are tested
      if(h1 == key || h2 == key || h3 == key || h4 == key)
        {
         // INFERRED: decompiler garbled the expiry comparison (shown as "== 238")
         if(TimeCurrent() > stamp)
            Alert("EXPIRED KEY!");
         else
           {
            Alert("Key Valid to:" + IntegerToString(TimeDay(stamp)) + "." + IntegerToString(TimeMonth(stamp)) + "." + IntegerToString(TimeYear(stamp)));
            g_blocked = false;
           }
         return INIT_SUCCEEDED;
        }
     }

   Alert("INVALID KEY!");
   ExpertRemove();
   g_openOrders = CountMarketOrders();
   return INIT_SUCCEEDED;
  }

