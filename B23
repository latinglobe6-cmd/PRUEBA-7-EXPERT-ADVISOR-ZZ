//| Expert tick                                                      |
//+------------------------------------------------------------------+
void OnTick()
  {
   if(IsTradingTime())
      UpdateSpreadStats();

   DrawInfoPanel();
   FixNewOrderSlTp();

   if(StringSubstr(_Symbol, 0, 3) != "XAU" && StringSubstr(_Symbol, 0, 4) != "GOLD")
     {
      Comment("\nUnsupported currency pair! Supported currency pairs: XAUUSD and GOLD");
      Alert("Unsupported currency pair! Supported currency pairs: XAUUSD and GOLD");
      Sleep(10000);
      return;
     }
   if(!IsTesting() && Period() != PERIOD_M15 && Period() != PERIOD_M30)
     {
      Comment("\nPlease, switch to M15 or M30 chart!");
      Alert("Please, switch to M15 or M30 chart!");
      Sleep(10000);
      return;
     }
   if(g_blocked)
      return;

   TrailingStopProc();
   VirtualTrailingProc();
   if(UseBreakEven)
      BreakEvenProc();

   if(!IsTradingTime())
     {
      while(!DeleteAllPending())
        {
        }
      return;
     }

   if(Email)
      EmailNotifications();

   //--- once per new chart bar
   datetime barTime = Time[0];
   if(g_lastBarTime == barTime)
      return;

   UpdateZigZagLevels();

   // remove stale stop orders
   for(int i = 0; i < OrdersTotal(); i++)
     {
      if(OrderSelect(i, SELECT_BY_POS, MODE_TRADES) && OrderSymbol() == _Symbol && OrderType() > OP_SELLLIMIT && OrderMagicNumber() == Magic)
        {
         bool buyStopStale = (NormalizeDouble(Distance * g_pip + g_upperHi, 5) < OrderOpenPrice());
         if(OrderType() == OP_BUYSTOP && buyStopStale && g_upperHi > Ask && g_upperHi == g_firstHi
            && !OrderDelete(OrderTicket(), clrNONE))
            Print("Error deleting BUYSTOP order.");

         bool sellStopStale = (NormalizeDouble(g_lowerLo - Distance * g_pip, 5) > OrderOpenPrice());
         if(OrderType() == OP_SELLSTOP && sellStopStale && g_lowerLo < Bid && g_lowerLo == g_firstLo
            && !OrderDelete(OrderTicket(), clrNONE))
            Print("Error deleting SELLSTOP order.");
        }
     }

   // what does this EA already have open?
   bool hasBuyStop = false, hasSellStop = false, hasBuy = false, hasSell = false;
   for(int i = 0; i < OrdersTotal(); i++)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(Magic >= 0 && OrderMagicNumber() != Magic)
         continue;
      if(OrderSymbol() != _Symbol)
         continue;
      switch(OrderType())
        {
         case OP_BUYSTOP:  hasBuyStop = true;  break;
         case OP_SELLSTOP: hasSellStop = true; break;
         case OP_BUY:      hasBuy = true;      break;
         case OP_SELL:     hasSell = true;     break;
        }
     }

   if(!hasBuyStop)
      if(!g_spreadTooHigh && g_upperHi > 0.0 && Bid < g_upperHi && !hasBuy && g_upperHi >= g_firstHi)
         PlaceStopOrder(OP_BUYSTOP);

   if(!hasSellStop)
      if(!g_spreadTooHigh && g_lowerLo > 0.0 && Ask > g_lowerLo && !hasSell && g_lowerLo <= g_firstLo)
         PlaceStopOrder(OP_SELLSTOP);

   g_lastBarTime = barTime;
  }

