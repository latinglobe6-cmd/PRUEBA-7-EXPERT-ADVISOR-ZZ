//+------------------------------------------------------------------+
//| Trailing stop (was func_401)                                     |
//+------------------------------------------------------------------+
void TrailingStopProc()
  {
   if(TrailingStop <= 0)
      return;
   if(!UseTrailingStop)
      return;

   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != _Symbol)
         continue;
      if(OrderMagicNumber() != Magic)
         continue;

      if(OrderType() == OP_BUY)
        {
         double mktBid = MarketInfo(_Symbol, MODE_BID);
         if(mktBid - OrderOpenPrice() > g_trailPx)
           {
            double newSl = NormalizeDouble(mktBid - g_trailPx, Digits);
            if(OrderStopLoss() < newSl)
              {
               RefreshRates();
               if(Bid - newSl <= MarketInfo(_Symbol, MODE_STOPLEVEL) * Point)
                  newSl = Bid - MarketInfo(_Symbol, MODE_STOPLEVEL) * Point;
               if(!OrderModify(OrderTicket(), OrderOpenPrice(), newSl, OrderTakeProfit(), 0, clrGreen))
                 {
                  int err = GetLastError();
                  ResetLastError();
                  string desc = ErrorDescription(err);
                  Print(OrderSymbol(), " Error modifying buy trade ", OrderTicket(), ". Error: ", desc);
                 }
              }
           }
        }

      if(OrderType() != OP_SELL)
         continue;
      double mktAsk = MarketInfo(_Symbol, MODE_ASK);
      if(!(OrderOpenPrice() - mktAsk > g_trailPx))
         continue;
      double newSl = NormalizeDouble(mktAsk + g_trailPx, Digits);
      if(OrderStopLoss() > newSl || OrderStopLoss() == 0.0)
        {
         RefreshRates();
         if(newSl - Ask <= MarketInfo(_Symbol, MODE_STOPLEVEL) * Point)
            newSl = MarketInfo(_Symbol, MODE_STOPLEVEL) * Point + Ask;
         if(!OrderModify(OrderTicket(), OrderOpenPrice(), newSl, OrderTakeProfit(), 0, clrRed))
           {
            int err = GetLastError();
            ResetLastError();
            string desc = ErrorDescription(err);
            Print(OrderSymbol(), " Error modifying sell trade ", OrderTicket(), ". Error: ", desc);
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Break-even (was func_402)                                        |
//+------------------------------------------------------------------+
void BreakEvenProc()
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         return;
      if(OrderType() > OP_SELL)
         continue;
      if(OrderSymbol() != _Symbol)
         continue;
      if(OrderMagicNumber() != Magic)
         continue;

      double sl = OrderStopLoss();
      if(OrderType() == OP_BUY)
        {
         RefreshRates();
         double newSl = NormalizeDouble(OrderOpenPrice() + g_beLockPx, Digits);
         if(Bid - OrderOpenPrice() > g_beDistPx
            && (newSl > sl || sl == 0.0)
            && newSl < Bid - g_stopLevelPx
            && MathAbs(newSl - sl) > Point)
           {
            WaitTradeAllowed(500);
            RefreshRates();
            if(OrderModify(OrderTicket(), OrderOpenPrice(), newSl, OrderTakeProfit(), 0, clrGreen))
               return;
           }
        }

      if(OrderType() != OP_SELL)
         continue;
      RefreshRates();
      double newSl = NormalizeDouble(OrderOpenPrice() - g_beLockPx, Digits);
      if(OrderOpenPrice() - Ask > g_beDistPx
         && (newSl < sl || sl == 0.0)
         && newSl > Ask + g_stopLevelPx
         && MathAbs(newSl - sl) > Point)
        {
         WaitTradeAllowed(500);
         RefreshRates();
         if(OrderModify(OrderTicket(), OrderOpenPrice(), newSl, OrderTakeProfit(), 0, clrRed))
           {
            // as decompiled: this log line runs after a *successful* sell modify
            int err = GetLastError();
            ResetLastError();
            Print("Error modify SELL order : ", err);
            return;
           }
        }
     }
  }

//+------------------------------------------------------------------+
//| Re-apply SL/TP on orders younger than 35 s (was func_414)        |
//+------------------------------------------------------------------+
void FixNewOrderSlTp()
  {
   for(int i = OrdersTotal() - 1; i >= 0; i--)
     {
      if(!OrderSelect(i, SELECT_BY_POS, MODE_TRADES))
         continue;
      if(OrderSymbol() != _Symbol)
         continue;
      if(OrderMagicNumber() != Magic)
         continue;
      if(!(TimeCurrent() < OrderOpenTime() + 35))
         continue;
      if(OrderType() != OP_BUY && OrderType() != OP_SELL)
         continue;

      double open = OrderOpenPrice();
      bool slOff = (NormalizeDouble(MathAbs(open - OrderStopLoss()) - g_slPx, Digits) > 0.0 && g_slPx > 0.0);
      bool tpOff = (NormalizeDouble(MathAbs(OrderTakeProfit() - open) - g_tpPx, Digits) > 0.0 && g_tpPx > 0.0);
      if(slOff || tpOff)
         ApplySlTp(OrderType() == OP_BUY);
     }
  }

