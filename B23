// newest buy/sell by open or close time; -1 none, 0 if OrderSelect failed mid-scan
int FindLatestMarketOrder(const int pool, const bool byCloseTime)
  {
   datetime latest = 0;
   int ticket = -1;
   int total = (pool == MODE_HISTORY) ? OrdersHistoryTotal() : OrdersTotal();
   for(int i = 0; i < total; i++)
     {
      if(!OrderSelect(i, SELECT_BY_POS, pool))
         return 0;
      if(OrderType() > OP_SELL)
         continue;
      if(OrderSymbol() != _Symbol)
         continue;
      if(OrderMagicNumber() != Magic)
         continue;
      datetime t = byCloseTime ? OrderCloseTime() : OrderOpenTime();
      if(t > latest)
        {
         ticket = OrderTicket();
         latest = t;
        }
     }
   return ticket;
  }

void SendOrderMail(const string text)
  {
   if(!SendMail("Scalp", text))
     {
      int err = GetLastError();
      ResetLastError();
      Print("Error sending mail: ", err);
     }
  }

void EmailNotifications()
  {
   if(CountMarketOrders() < g_openOrders)
     {
      int ticket = FindLatestMarketOrder(MODE_HISTORY, true);
      if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_HISTORY))
        {
         string side = (OrderType() == OP_BUY) ? "buy" : "sell";
         SendOrderMail(StringConcatenate("Closed ", side, " order on ", _Symbol, " at price: ", OrderClosePrice()));
        }
     }
   if(CountMarketOrders() > g_openOrders)
     {
      int ticket = FindLatestMarketOrder(MODE_TRADES, false);
      if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
        {
         string side = (OrderType() == OP_BUY) ? "buy" : "sell";
         SendOrderMail(StringConcatenate("Opened ", side, " order on ", _Symbol, " at price: ", OrderOpenPrice()));
        }
     }
   g_openOrders = CountMarketOrders();
  }

//+------------------------------------------------------------------+
//| Stop-order placement (was inlined twice in OnTick)               |
//+------------------------------------------------------------------+
void PlaceStopOrder(const int cmd)
  {
   double lots = CalcLots();
   double stopDist = MarketInfo(_Symbol, MODE_STOPLEVEL) * Point;
   double price;
   if(cmd == OP_BUYSTOP)
     {
      price = NormalizeDouble(Distance * g_pip + g_upperHi, Digits);
      if(price - MarketInfo(_Symbol, MODE_ASK) <= stopDist)
         price = MarketInfo(_Symbol, MODE_ASK) + stopDist;
     }
   else
     {
      price = NormalizeDouble(g_lowerLo - Distance * g_pip, Digits);
      if(MarketInfo(_Symbol, MODE_BID) - price <= stopDist)
         price = MarketInfo(_Symbol, MODE_BID) - stopDist;
     }

   WaitTradeAllowed(50);
   WaitTradeContext(50);
   int ticket = OrderSend(_Symbol, cmd, lots, price, SLIPPAGE, 0.0, 0.0, Name_EA, Magic, 0, clrNONE);
   if(ticket > 0)
     {
      if(OrderSelect(ticket, SELECT_BY_TICKET, MODE_TRADES))
         ApplySlTp(cmd == OP_BUYSTOP);
     }
   else
     {
      int err = GetLastError();
      ResetLastError();
      Print(_Symbol, " Unable to open order! Error: ", err);
     }
  }

